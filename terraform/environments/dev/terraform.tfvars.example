aws_region    = "us-east-1"
project_name  = "palavracadabra"
environment   = "dev"
db_password   = "CHANGE_ME_use_a_strong_password"

# Dev sizing (minimal costs)
db_instance_class = "db.t3.micro"
redis_node_type   = "cache.t3.micro"
api_cpu           = 256
api_memory        = 512
api_desired_count = 1
vpc_cidr          = "10.0.0.0/16"
